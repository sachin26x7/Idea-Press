# Set NODE_ENV=development and this to true for local development only.
# Production email verification stays enabled.
DISABLE_EMAIL_VERIFICATION=false

# SMTP settings are needed when a user signs up or explicitly requests a password reset.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
EMAIL_FROM=IdeaPress <your-gmail-address@gmail.com>
